# Release preparation replaces @SOURCE_SHA256@ and attaches this recipe next to
# the exact source archive. Download the release recipe, not this template.
pkgname=bang
pkgver=0.1.0
pkgrel=1
pkgdesc='Experimental Linux desktop mail client'
arch=('x86_64')
url='https://github.com/augustin-laurent/Bang'
license=('MIT' 'OFL-1.1')
depends=('gtk3' 'webkit2gtk-4.1' 'openssl' 'ca-certificates')
makedepends=('rust' 'cargo' 'nodejs' 'npm' 'pkgconf' 'python')
source=("$url/releases/download/v$pkgver/Bang-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')
build() {
  cd "Bang-$pkgver"
  npm ci --prefix crates/composer/web
  npm run build --prefix crates/composer/web
  cargo build --release --workspace --locked
}
check() {
  cd "Bang-$pkgver"
  npm test --prefix crates/composer/web
  cargo test -p bang-core --locked --features integration
}
package() {
  cd "Bang-$pkgver"
  install -Dm755 target/release/app "$pkgdir/usr/lib/bang/app"
  install -Dm755 target/release/bang-service "$pkgdir/usr/lib/bang/bang-service"
  install -Dm755 target/release/bang-compose "$pkgdir/usr/lib/bang/bang-compose"
  install -Dm755 packaging/bang "$pkgdir/usr/bin/bang"
  install -Dm644 packaging/bang.desktop "$pkgdir/usr/share/applications/bang.desktop"
  install -Dm644 packaging/io.github.augustin_laurent.Bang.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.augustin_laurent.Bang.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/bang/LICENSE"
  install -Dm644 assets/fonts/OFL.txt "$pkgdir/usr/share/licenses/bang/OFL.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/bang/README.md"
}
