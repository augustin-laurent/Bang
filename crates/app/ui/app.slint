import { Button, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
// Re-export so Rust can reach the global: only the entry file's exports
// get public-API treatment (otherwise its properties are constant-folded).
export { Theme } from "theme.slint";
import { FolderRow, MessageRow, AccountRow } from "models.slint";
import { Sidebar } from "sidebar.slint";
import { MessageList } from "messagelist.slint";
import { ReadingPane } from "readingpane.slint";
import { AccountWizard } from "accountwizard.slint";
import { SettingsDialog } from "settingsdialog.slint";

// Bang main window: three-pane layout (sidebar, message list, reading pane).
export component BangApp inherits Window {
    title: "Bang";
    preferred-width: 1100px;
    preferred-height: 680px;
    min-width: 720px;
    min-height: 420px;

    // Data, set from Rust.
    in property <[FolderRow]> folders;
    in-out property <[MessageRow]> messages;
    in property <int> selected-folder: -1;
    in property <int> selected-message: -1;
    in property <string> folder-name: "";
    /// Search box content (cleared from Rust when a folder is selected).
    in-out property <string> search-text;
    in property <string> account-status: "";
    in property <string> status-message: "";
    in property <string> message-sender: "";
    in property <string> message-subject: "";
    in property <string> message-date: "";
    in property <string> message-body: "";

    // Account wizard.
    in-out property <bool> wizard-open: false;
    in property <string> wizard-status: "";

    // Settings dialog.
    in-out property <bool> settings-open: false;
    in property <[AccountRow]> settings-accounts;
    in property <string> settings-theme: "system";

    // Generic account form (read from Rust on submit).
    in-out property <string> email;
    in-out property <string> imap-host;
    in-out property <string> imap-port: "993";
    in-out property <string> smtp-host;
    in-out property <string> smtp-port: "465";
    in-out property <string> username;
    in-out property <string> password;
    in-out property <bool> starttls: false;

    callback wizard-oauth-clicked(provider: string);
    callback wizard-add-generic();
    callback wizard-cancel();

    callback folder-selected(id: int);
    callback message-selected(id: int);
    callback message-action(id: int, action: string);
    callback compose-clicked();
    callback search-edited(text: string);
    callback settings-opened();
    callback settings-theme-selected(mode: string);
    callback settings-account-remove(id: string);
    callback settings-close();

    HorizontalLayout {
        padding: 0;
        spacing: 0;

        Sidebar {
            width: 220px;
            folders: root.folders;
            selected-folder: root.selected-folder;
            account-status: root.account-status;
            add-account => {
                root.wizard-open = true;
            }
            folder-clicked(id) => {
                root.folder-selected(id);
            }
        }

        VerticalLayout {
            spacing: 0;

            // Toolbar: folder title, search box, compose button.
            Rectangle {
                height: 48px;
                background: Theme.bg;

                Text {
                    text: root.folder-name == "" ? "Inbox" : root.folder-name;
                    x: Theme.space-lg;
                    y: 14px;
                    width: 180px;
                    color: Theme.text;
                    font-size: Theme.font-size-xl;
                    font-weight: Theme.font-weight-semibold;
                    overflow: elide;
                }

                Text {
                    visible: root.status-message != "";
                    text: root.status-message;
                    x: Theme.space-lg;
                    y: 30px;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-xs;
                }

                LineEdit {
                    x: 200px;
                    y: 10px;
                    width: 220px;
                    height: 28px;
                    text <=> root.search-text;
                    placeholder-text: "Search";
                    edited(text) => {
                        root.search-edited(text);
                    }
                }

                Button {
                    text: "⚙";
                    x: parent.width - 140px;
                    y: 10px;
                    width: 28px;
                    height: 28px;
                    clicked => {
                        root.settings-opened();
                    }
                }

                Button {
                    text: "Compose";
                    x: parent.width - 104px;
                    y: 10px;
                    width: 92px;
                    clicked => {
                        root.compose-clicked();
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            MessageList {
                min-width: 280px;
                messages: root.messages;
                selected-message: root.selected-message;
                message-clicked(id) => {
                    root.message-selected(id);
                }
                message-action(id, action) => {
                    root.message-action(id, action);
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        ReadingPane {
            min-width: 320px;
            sender: root.message-sender;
            subject: root.message-subject;
            date: root.message-date;
            body: root.message-body;
        }
    }

    AccountWizard {
        open: root.wizard-open;
        status: root.wizard-status;
        email <=> root.email;
        imap-host <=> root.imap-host;
        imap-port <=> root.imap-port;
        smtp-host <=> root.smtp-host;
        smtp-port <=> root.smtp-port;
        username <=> root.username;
        password <=> root.password;
        starttls <=> root.starttls;
        oauth-clicked(provider) => {
            root.wizard-oauth-clicked(provider);
        }
        add-generic => {
            root.wizard-add-generic();
        }
        cancel => {
            root.wizard-cancel();
        }
    }

    SettingsDialog {
        open: root.settings-open;
        accounts: root.settings-accounts;
        theme: root.settings-theme;
        theme-selected(mode) => {
            root.settings-theme-selected(mode);
        }
        account-remove(id) => {
            root.settings-account-remove(id);
        }
        close => {
            root.settings-close();
        }
    }
}

// Compose window: to/cc/bcc/subject/body and send/cancel.
// A second exported component so Rust can instantiate it as its own window.
export component ComposeWindow inherits Window {
    title: "New message";
    preferred-width: 640px;
    preferred-height: 520px;
    min-width: 420px;
    min-height: 320px;

    /// Sender (the selected account's email).
    in property <string> from: "";

    in-out property <string> to;
    in-out property <string> cc;
    in-out property <string> bcc;
    in-out property <string> subject;
    in-out property <string> body;

    /// File path to attach (read from Rust on attach).
    in-out property <string> attach-path;
    /// Names of the staged attachments (set from Rust).
    in property <string> attachments: "";

    callback send();
    callback cancel();
    callback attach-clicked();

    VerticalLayout {
        padding: Theme.space-lg;
        spacing: Theme.space-sm;

        Text {
            text: "From: " + root.from;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
        }

        LineEdit {
            text <=> root.to;
            placeholder-text: "To";
        }

        LineEdit {
            text <=> root.cc;
            placeholder-text: "Cc";
        }

        LineEdit {
            text <=> root.bcc;
            placeholder-text: "Bcc";
        }

        LineEdit {
            text <=> root.subject;
            placeholder-text: "Subject";
        }

        HorizontalLayout {
            spacing: Theme.space-sm;

            LineEdit {
                text <=> root.attach-path;
                placeholder-text: "Attachment file path";
            }

            Button {
                text: "Attach";
                clicked => {
                    root.attach-clicked();
                }
            }
        }

        Text {
            visible: root.attachments != "";
            text: "Attached: " + root.attachments;
            color: Theme.text-secondary;
            font-size: Theme.font-size-xs;
            wrap: word-wrap;
        }

        Rectangle {
            background: Theme.reading-bg;
            border-radius: Theme.radius-sm;

            TextInput {
                x: Theme.space-sm;
                y: Theme.space-sm;
                width: parent.width - 2 * Theme.space-sm;
                height: parent.height - 2 * Theme.space-sm;
                text <=> root.body;
                single-line: false;
                wrap: word-wrap;
                color: Theme.text;
                font-size: Theme.font-size-lg;
            }
        }

        HorizontalLayout {
            spacing: Theme.space-sm;
            alignment: end;

            Button {
                text: "Cancel";
                clicked => {
                    root.cancel();
                }
            }

            Button {
                text: "Send";
                primary: true;
                clicked => {
                    root.send();
                }
            }
        }
    }
}
