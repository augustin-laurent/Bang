import { Theme } from "theme.slint";
import { FolderRow, MessageRow } from "models.slint";
import { Sidebar } from "sidebar.slint";
import { MessageList } from "messagelist.slint";
import { ReadingPane } from "readingpane.slint";
import { AccountWizard } from "accountwizard.slint";

// Bang main window: three-pane layout (sidebar, message list, reading pane).
export component BangApp inherits Window {
    title: "Bang";
    preferred-width: 1100px;
    preferred-height: 680px;
    min-width: 720px;
    min-height: 420px;

    // Data, set from Rust.
    in property <[FolderRow]> folders;
    in-out property <[MessageRow]> messages;
    in property <int> selected-folder: -1;
    in property <int> selected-message: -1;
    in property <string> folder-name: "";
    in property <string> account-status: "";
    in property <string> status-message: "";
    in property <string> message-sender: "";
    in property <string> message-subject: "";
    in property <string> message-date: "";
    in property <string> message-body: "";

    // Account wizard.
    in-out property <bool> wizard-open: false;
    in property <string> wizard-status: "";

    // Generic account form (read from Rust on submit).
    in-out property <string> email;
    in-out property <string> imap-host;
    in-out property <string> imap-port: "993";
    in-out property <string> smtp-host;
    in-out property <string> smtp-port: "465";
    in-out property <string> username;
    in-out property <string> password;
    in-out property <bool> starttls: false;

    callback wizard-oauth-clicked(provider: string);
    callback wizard-add-generic();
    callback wizard-cancel();

    callback folder-selected(id: int);
    callback message-selected(id: int);

    HorizontalLayout {
        padding: 0;
        spacing: 0;

        Sidebar {
            width: 220px;
            folders: root.folders;
            selected-folder: root.selected-folder;
            account-status: root.account-status;
            add-account => {
                root.wizard-open = true;
            }
            folder-clicked(id) => {
                root.folder-selected(id);
            }
        }

        VerticalLayout {
            spacing: 0;

            // Toolbar (search bar and actions arrive in later commits).
            Rectangle {
                height: 48px;
                background: Theme.bg;

                Text {
                    text: root.folder-name == "" ? "Inbox" : root.folder-name;
                    x: Theme.space-lg;
                    y: 14px;
                    color: Theme.text;
                    font-size: Theme.font-size-xl;
                    font-weight: Theme.font-weight-semibold;
                }

                Text {
                    visible: root.status-message != "";
                    text: root.status-message;
                    x: Theme.space-lg;
                    y: 30px;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-xs;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            MessageList {
                min-width: 280px;
                messages: root.messages;
                selected-message: root.selected-message;
                message-clicked(id) => {
                    root.message-selected(id);
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        ReadingPane {
            min-width: 320px;
            sender: root.message-sender;
            subject: root.message-subject;
            date: root.message-date;
            body: root.message-body;
        }
    }

    AccountWizard {
        open: root.wizard-open;
        status: root.wizard-status;
        email <=> root.email;
        imap-host <=> root.imap-host;
        imap-port <=> root.imap-port;
        smtp-host <=> root.smtp-host;
        smtp-port <=> root.smtp-port;
        username <=> root.username;
        password <=> root.password;
        starttls <=> root.starttls;
        oauth-clicked(provider) => {
            root.wizard-oauth-clicked(provider);
        }
        add-generic => {
            root.wizard-add-generic();
        }
        cancel => {
            root.wizard-cancel();
        }
    }
}
