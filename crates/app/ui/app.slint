import "../../../assets/fonts/NotoSans-Regular.ttf";
import "../../../assets/fonts/NotoSans-Bold.ttf";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";
export { Palette } from "std-widgets.slint";
import { ListView } from "std-widgets.slint";
import { LineEdit } from "std-widgets.slint";
import { ActionButton, SearchField } from "controls.slint";
import { FolderRow, MessageRow, AccountRow, AttachmentRow, DraftRow, TemplateRow, PendingSendRow, LabelRow, CategoryRow } from "models.slint";
import { CategoryBar } from "categories.slint";
import { OrganizationDialog } from "organizationdialog.slint";
import { Sidebar } from "sidebar.slint";
import { MessageList } from "messagelist.slint";
import { ReadingPane } from "readingpane.slint";
import { AccountWizard } from "accountwizard.slint";
import { WelcomeScreen } from "welcome.slint";
import { SettingsDialog } from "settingsdialog.slint";
import { AttachmentPreview } from "attachmentpreview.slint";
import { SaveDialog } from "savedialog.slint";
import { DraftsDialog } from "draftsdialog.slint";
import { ContextMenuItem } from "contextmenu.slint";

export component BangApp inherits Window {
    title: "Bang"; preferred-width: 1440px; preferred-height: 900px;
    min-width: 720px; min-height: 480px; background: Theme.bg;
    default-font-family: "Noto Sans"; default-font-size: 13px;
    in property <[FolderRow]> folders; in-out property <[MessageRow]> messages;
    in property <[LabelRow]> labels;
    in property <[CategoryRow]> categories;
    in-out property <int> selected-label: -1;
    in-out property <string> selected-category: "";
    in property <bool> categories-visible: false;
    in-out property <bool> online-avatars: true;
    in property <bool> message-avatar-loaded; in property <image> message-avatar; in property <color> message-avatar-tint;
    in-out property <bool> organization-open: false;
    in-out property <bool> managing-labels: false;
    in-out property <int> organization-message: -1;
    in-out property <int> organization-category: 0;
    in property <string> organization-effective;
    in property <bool> organization-message-override;
    in property <bool> organization-sender-override;
    in property <string> organization-error;
    callback avatar-requested(string); callback avatars-toggled(bool);
    callback category-selected(string); callback label-selected(int);
    callback organization-opened(bool); callback organization-close();
    callback category-saved(int, bool);
    callback label-assigned(int, bool); callback label-saved(int, string, string); callback label-deleted(int);
    in property <int> account-count: 0;
    in property <int> selected-folder: -1; in property <int> selected-message: -1;
    in-out property <int> selection-count: 0;
    callback selection-clicked(int, bool, bool, int);
    callback batch-action(string);
    in property <string> folder-name; in-out property <string> search-text;
    in property <bool> search-active: false;
    in property <string> status-message;
    in property <string> message-sender; in property <string> message-subject;
    in property <string> message-date; in property <string> message-body;
    in property <string> message-sender-address; in property <string> message-recipients;
    in property <string> message-initials;
    in property <[AttachmentRow]> message-attachments;
    in property <bool> message-loading: false;
    in-out property <string> message-html;
    in property <bool> native-reader-available: false;
    in property <bool> reader-failed: false;
    in-out property <bool> remote-images: false;
    out property <bool> html-active: root.native-reader-available && !root.reader-failed && !root.message-loading && root.message-html != "";
    out property <bool> reader-shown: root.html-active && root.reader-visible && root.selected-message >= 0 && !root.modal-open && !root.preview-open && !root.save-open && !root.sidebar-overlay && !message-menu.is-open && !move-menu.is-open && !folder-menu.is-open;
    out property <float> reader-x-px: reader.body-x / 1px;
    out property <float> reader-y-px: reader.body-y / 1px;
    out property <float> reader-width-px: reader.body-width / 1px;
    out property <float> reader-height-px: reader.body-height / 1px;
    callback reader-load-images();
    in property <bool> message-starred: false;
    in-out property <bool> preview-open: false;
    in property <string> preview-title; in property <string> preview-kind;
    in property <string> preview-text; in property <image> preview-image;
    in property <string> preview-path;
    in-out property <bool> save-open: false;
    in property <string> save-filename; in-out property <string> save-path;
    in-out property <bool> drafts-open: false; in-out property <bool> templates-open: false;
    in-out property <bool> sends-open: false;
    in property <[DraftRow]> drafts; in property <[TemplateRow]> templates; in property <[PendingSendRow]> sends;
    in-out property <bool> welcome-open: false;
    in-out property <int> welcome-step: 0;
    in-out property <string> welcome-error;
    in-out property <bool> welcome-motion: true;
    callback welcome-add-account(); callback welcome-finish();
    callback welcome-focus();
    private property <int> welcome-focus-request: 0;
    welcome-focus => { root.welcome-focus-request += 1; }
    in-out property <bool> wizard-open: false; in-out property <bool> wizard-manual: false; in-out property <string> wizard-status;
    in-out property <bool> wizard-busy: false;
    in-out property <int> wizard-attempt: 0;
    in-out property <string> wizard-provider;
    in-out property <bool> wizard-advanced: false;
    in-out property <bool> wizard-settings-ready: false;
    in-out property <bool> wizard-storage-error: false;
    in-out property <string> wizard-reconnect-id;
    in-out property <bool> google-available: true;
    in-out property <bool> microsoft-available: false;
    in-out property <string> smtp-username;
    in-out property <bool> settings-open: false;
    in property <[AccountRow]> settings-accounts; in property <string> settings-theme: "system";
    in property <string> settings-language: "system";
    in-out property <string> email; in-out property <string> imap-host;
    in-out property <string> imap-port: "993"; in-out property <string> smtp-host;
    in-out property <string> smtp-port: "465"; in-out property <string> username;
    in-out property <string> password; in-out property <bool> starttls: false; in-out property <bool> smtp-starttls: false;
    callback wizard-provider-selected(string); callback wizard-oauth-clicked(string); callback wizard-add-generic(); callback wizard-cancel();
    callback wizard-discover(); callback wizard-storage-choice(bool); callback wizard-app-password();
    callback wizard-email-edited(string);
    callback folder-selected(int); callback account-toggled(string);
    callback folder-context(int, length, length);
    callback folder-action(int, string, string);
    callback message-selected(int); callback message-action(int, string);
    // Right-click menus. Rust fills the menu state from the store, then the
    // Slint side shows the popup at the requested window coordinates.
    callback message-context(int, length, length);
    callback show-menu();
    show-menu => { message-menu.show(); }
    callback show-move-menu();
    show-move-menu => { move-menu.show(); }
    callback show-folder-menu();
    show-folder-menu => { folder-menu.show(); }
    in-out property <int> menu-message: -1;
    in-out property <bool> menu-msg-unread: false;
    in-out property <bool> menu-msg-starred: false;
    // True when the message sits in Trash/Junk: delete becomes permanent.
    in-out property <bool> menu-msg-permanent: false;
    in-out property <bool> menu-batch: false;
    // Folders offered by the "Move to..." submenu (message's account only).
    in property <[FolderRow]> move-folders;
    callback move-selected(int);
    in-out property <length> menu-x: 0px; in-out property <length> menu-y: 0px;
    in-out property <int> menu-folder: -1;
    in-out property <string> menu-folder-kind: "folder";
    in-out property <string> menu-folder-name: "";
    in-out property <bool> menu-folder-inbox: false;
    in-out property <string> folder-dialog-mode: "";
    in-out property <string> folder-dialog-name: "";
    callback reveal-message(int);
    reveal-message(index) => { message-list.reveal-row(index); }
    callback reset-message-scroll();
    reset-message-scroll => { message-list.reset-scroll(); }
    callback compose-clicked(); callback search-edited(string); callback navigate-message(int);
    callback attachment-clicked(int); callback attachment-save(string);
    callback drafts-opened(); callback templates-opened(); callback sends-opened();
    callback draft-row-clicked(int); callback draft-row-delete(int);
    callback template-row-clicked(int); callback template-row-delete(int);
    callback send-row-delete(int);
    callback drafts-dialog-close();
    callback focus-chrome();
    focus-chrome => { keyboard.focus(); }
    callback quit();
    callback settings-opened(); callback settings-theme-selected(string);
    callback settings-language-selected(string); callback settings-account-remove(string); callback settings-close();
    callback settings-account-reconnect(string);
    callback settings-account-unlock(string);

    private property <bool> modal-open: root.welcome-open || root.wizard-open || root.settings-open || root.drafts-open || root.templates-open || root.sends-open || root.organization-open || root.folder-dialog-mode != "";
    changed modal-open => { Theme.blocked = self.modal-open; }
    private property <length> sidebar-size: 260px;
    private property <length> list-size: 384px;
    private property <bool> sidebar-hidden: false;
    private property <bool> sidebar-overlay: false;
    private property <bool> detail-open: false;
    private property <bool> narrow: root.width < 900px;
    private property <bool> show-nav: root.width >= 1120px && !sidebar-hidden;
    private property <length> nav-width: show-nav ? sidebar-size : 0px;
    private property <length> actual-list-width: narrow ? root.width : min(list-size, (root.width - nav-width) * 0.48);
    private property <length> reader-x: nav-width + actual-list-width + 1px;
    private property <bool> list-visible: !narrow || !detail-open;
    private property <bool> reader-visible: !narrow || detail-open;
    forward-focus: keyboard;
    keyboard := FocusScope {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        key-pressed(e) => {
            if e.modifiers.control && (e.text == "q" || e.text == "Q") { root.quit(); return accept; }
            if root.modal-open {
                if e.text == Key.Escape {
                    if root.organization-open { root.organization-close(); }
                    else if root.wizard-open { root.wizard-cancel(); }
                    else if root.settings-open { root.settings-close(); }
                    else if root.welcome-open { root.welcome-step = max(0, root.welcome-step - 1); }
                    else { root.drafts-open = false; root.templates-open = false; root.sends-open = false; }
                    return accept;
                }
                return reject;
            }
            // Global shortcuts.
            if e.modifiers.control && (e.text == "n" || e.text == "N") { root.compose-clicked(); return accept; }
            if e.modifiers.control && (e.text == "f" || e.text == "F") { if root.narrow { list-search.focus-input(); } else { search.focus-input(); } return accept; }
            if e.text == Key.Escape { root.detail-open = false; root.sidebar-overlay = false; return accept; }
            // Message navigation: j/k mirror the arrows; Home/End jump to the ends.
            if e.text == Key.DownArrow || e.text == "j" { root.navigate-message(1); return accept; }
            if e.text == Key.UpArrow || e.text == "k" { root.navigate-message(-1); return accept; }
            if e.text == Key.Home { root.navigate-message(-100000); return accept; }
            if e.text == Key.End { root.navigate-message(100000); return accept; }
            // Message actions on the selected row.
            if root.selected-message >= 0 {
                if e.text == "s" { root.message-action(root.selected-message, "star"); return accept; }
                if e.text == "u" { root.message-action(root.selected-message, "read"); return accept; }
                if e.text == "d" { root.message-action(root.selected-message, "delete"); return accept; }
            }
            return reject;
        }
    Rectangle {
        width: parent.width; height: parent.height; visible: !root.welcome-open;
    Sidebar {
        visible: root.show-nav; x: 0px; y: 0px; width: root.nav-width; height: parent.height;
        folders: root.folders; selected-folder: root.selected-folder;
        labels: root.labels; selected-label: root.selected-label;
        label-clicked(id) => { root.label-selected(id); root.sidebar-overlay = false; root.detail-open = false; }
        manage-labels => { root.sidebar-overlay = false; root.organization-opened(true); }
        hide => { root.sidebar-hidden = true; }
        add-account => { root.wizard-open = true; }
        settings => { root.settings-opened(); }
        folder-clicked(id) => { root.folder-selected(id); root.detail-open = false; }
        folder-context(id, x, y) => { root.folder-context(id, x, y); }
        account-toggled(id) => { root.account-toggled(id); }
    }
    nav-splitter := Rectangle {
        visible: root.show-nav; x: root.nav-width - 2px; width: 4px; height: parent.height;
        background: Theme.border;
        TouchArea { mouse-cursor: ew-resize; moved => { if self.pressed { root.sidebar-size = clamp(root.sidebar-size + self.mouse-x, 180px, 300px); } } }
    }
    // List stays instantiated when hidden so its scroll position is retained.
    Rectangle {
        visible: root.list-visible; x: root.nav-width; width: root.actual-list-width; height: parent.height;
        background: Theme.bg;
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: 52px; background: Theme.toolbar-bg;
            HorizontalLayout {
                padding: 10px; spacing: 8px;
                if !root.show-nav: ActionButton { text: @tr("Mailboxes"); icon: @image-url("icons/sidebar.svg"); compact: true; clicked => { if root.width >= 1120px { root.sidebar-hidden = false; } else { root.sidebar-overlay = true; } } }
                VerticalLayout { spacing: 2px;
                    Text { text: root.folder-name == "" ? @tr("All Inboxes") : root.folder-name; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                    Text { text: @tr("{n} message" | "{n} messages" % root.messages.length); color: Theme.text-secondary; font-size: 11px; }
                }
                ActionButton { framed: true; text: @tr("New message"); icon: @image-url("icons/compose.svg"); compact: true; clicked => { root.compose-clicked(); } }
                ActionButton { framed: true; text: @tr("Drafts"); icon: @image-url("icons/file.svg"); compact: true; clicked => { root.drafts-opened(); } }
                ActionButton { framed: true; text: @tr("Templates"); icon: @image-url("icons/folder.svg"); compact: true; clicked => { root.templates-opened(); } }
                ActionButton { framed: true; text: @tr("Scheduled"); icon: @image-url("icons/clock.svg"); compact: true; clicked => { root.sends-opened(); } }
            }
        }
        list-search := SearchField { visible: root.narrow; x: 10px; y: 56px; width: parent.width - 20px; height: 30px; text <=> root.search-text; placeholder: @tr("Search"); edited(text) => { root.search-edited(text); } }
        CategoryBar { visible: root.categories-visible && !root.search-active;
            y: root.narrow ? 94px : 53px; height: 54px; width: parent.width;
            categories: root.categories; selected: root.selected-category;
            selected-category(key) => { root.category-selected(key); }
        }
        Rectangle {
            visible: root.selection-count > 0;
            y: (root.narrow ? 94px : 53px) + (root.categories-visible && !root.search-active ? 54px : 0px);
            width: parent.width; height: 42px; background: Theme.toolbar-bg;
            HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 8px;
                Text { text: @tr("Selected:") + " " + root.selection-count; color: Theme.text; font-size: 13px; horizontal-stretch: 1; vertical-alignment: center; }
                ActionButton { compact: true; icon: @image-url("icons/mail.svg"); text: @tr("Mark read"); clicked => { root.batch-action("read"); } }
                ActionButton { compact: true; icon: @image-url("icons/star.svg"); text: @tr("Star"); clicked => { root.batch-action("star"); } }
                ActionButton { compact: true; icon: @image-url("icons/folder.svg"); text: @tr("Move to..."); clicked => { root.batch-action("move"); } }
                ActionButton { compact: true; icon: @image-url("icons/trash.svg"); text: @tr("Delete"); clicked => { root.batch-action("delete"); } }
            }
        }
        message-list := MessageList {
            y: (root.narrow ? 94px : 53px) + (root.categories-visible && !root.search-active ? 54px : 0px) + (root.selection-count > 0 ? 42px : 0px); height: parent.height - self.y; width: parent.width;
            messages: root.messages; selected-message: root.selected-message;
            message-clicked(id, control, shift, index) => {
                root.selection-clicked(id, control, shift, index);
                if !control && !shift { root.message-selected(id); root.detail-open = true; }
            }
            message-action(id, action) => { root.message-action(id, action); }
        }
        if root.account-count == 0 || root.messages.length == 0: Rectangle {
            y: (root.narrow ? 94px : 53px) + (root.categories-visible && !root.search-active ? 54px : 0px); height: parent.height - self.y; width: parent.width; background: Theme.bg;
            VerticalLayout { padding: 24px; spacing: 16px; alignment: center;
                Text { text: root.account-count == 0 ? @tr("Welcome to Bang") : root.search-active ? @tr("No results") : @tr("No messages"); font-size: 16px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                Text { text: root.account-count == 0 ? @tr("Add your first email account to get started.") : root.search-active ? @tr("Try another search.") : @tr("New messages will appear here."); font-size: 13px; color: Theme.text-secondary; wrap: word-wrap; horizontal-alignment: center; }
                if root.account-count == 0: ActionButton { text: @tr("Add account"); primary: true; clicked => { root.wizard-open = true; } }
            }
        }
    }
    Rectangle {
        visible: !root.narrow; x: root.reader-x - 2px; width: 4px; height: parent.height; background: Theme.border;
        TouchArea { mouse-cursor: ew-resize; moved => { if self.pressed { root.list-size = clamp(root.list-size + self.mouse-x, 280px, 480px); } } }
    }
    Rectangle {
        visible: root.reader-visible; x: root.narrow ? 0px : root.reader-x;
        width: root.narrow ? parent.width : parent.width - root.reader-x; height: parent.height;
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: 52px; background: Theme.toolbar-bg;
            HorizontalLayout { padding: 10px; spacing: 4px;
                if root.narrow: ActionButton { compact: true; text: @tr("Back"); icon: @image-url("icons/back.svg"); clicked => { root.detail-open = false; } }
                Rectangle { width: 294px; height: 32px; background: Theme.bg; border-width: 1px; border-color: Theme.border; border-radius: 12px;
                    HorizontalLayout { spacing: 0px;
                ActionButton { compact: true; text: @tr("Classify message"); icon: @image-url("icons/tag.svg"); enabled: root.selected-message >= 0; clicked => { root.organization-opened(false); } }
                ActionButton { compact: true; text: @tr("Reply"); icon: @image-url("icons/back.svg"); enabled: root.selected-message >= 0; clicked => { root.message-action(root.selected-message, "reply"); } }
                ActionButton { compact: true; text: @tr("Forward"); icon: @image-url("icons/send.svg"); enabled: root.selected-message >= 0; clicked => { root.message-action(root.selected-message, "forward"); } }
                ActionButton { compact: true; text: @tr("Star"); icon: @image-url("icons/star.svg"); enabled: root.selected-message >= 0; active: root.message-starred; clicked => { root.message-action(root.selected-message, "star"); } }
                ActionButton { compact: true; text: @tr("Read / unread"); icon: @image-url("icons/mail.svg"); enabled: root.selected-message >= 0; clicked => { root.message-action(root.selected-message, "read"); } }
                ActionButton { compact: true; text: @tr("Delete"); icon: @image-url("icons/trash.svg"); enabled: root.selected-message >= 0; clicked => { root.message-action(root.selected-message, "delete"); } }
                ActionButton { compact: true; text: @tr("Snooze"); icon: @image-url("icons/clock.svg"); enabled: root.selected-message >= 0; clicked => { root.message-action(root.selected-message, "snooze"); } }
                ActionButton { compact: true; text: @tr("Follow up"); icon: @image-url("icons/bell.svg"); enabled: root.selected-message >= 0; clicked => { root.message-action(root.selected-message, "follow-up"); } }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                search := SearchField { max-width: 264px; min-width: 100px; text <=> root.search-text; placeholder: @tr("Search"); edited(text) => { root.search-edited(text); } }
            }
        }
        reader := ReadingPane { x: 0px; width: parent.width; y: 53px; height: parent.height - 53px - (root.status-message == "" ? 0px : 36px);
            sender: root.message-sender; subject: root.message-subject; date: root.message-date; body: root.message-body;
            sender-address: root.message-sender-address; recipients: root.message-recipients; initials: root.message-initials;
            avatar: root.message-avatar; avatar-loaded: root.message-avatar-loaded; avatar-tint: root.message-avatar-tint;
            attachments: root.message-attachments;
            html-active: root.html-active; remote-images: root.remote-images;
            load-images => { root.reader-load-images(); }
            selected: root.selected-message >= 0; loading: root.message-loading;
            attachment-clicked(i) => { root.attachment-clicked(i); }
        }
        if root.status-message != "": Rectangle { y: parent.height - 36px; height: 36px; background: Theme.toolbar-bg;
            Text { x: 12px; width: parent.width - 24px; text: root.status-message; color: Theme.text-secondary; font-size: 12px; vertical-alignment: center; overflow: elide; }
        }
    }
    if root.sidebar-overlay: Rectangle {
        background: #00000044;
        TouchArea { clicked => { root.sidebar-overlay = false; } }
        Sidebar { width: 260px; folders: root.folders; selected-folder: root.selected-folder;
        labels: root.labels; selected-label: root.selected-label;
        label-clicked(id) => { root.label-selected(id); root.sidebar-overlay = false; root.detail-open = false; }
        manage-labels => { root.sidebar-overlay = false; root.organization-opened(true); }
            hide => { root.sidebar-overlay = false; }
            add-account => { root.sidebar-overlay = false; root.wizard-open = true; }
            settings => { root.sidebar-overlay = false; root.settings-opened(); }
            folder-clicked(id) => { root.folder-selected(id); root.sidebar-overlay = false; root.detail-open = false; }
            folder-context(id, x, y) => { root.folder-context(id, x, y); }
            account-toggled(id) => { root.account-toggled(id); }
        }
    }
    }
    if root.welcome-open: WelcomeScreen {
        active: true; focus-request: root.welcome-focus-request;
        width: parent.width; height: parent.height;
        step <=> root.welcome-step; motion: root.welcome-open && root.welcome-motion;
        interactive: root.welcome-open && !root.wizard-open;
        theme: root.settings-theme; language: root.settings-language;
        error: root.welcome-error; connected: root.account-count > 0;
        theme-selected(mode) => { root.settings-theme-selected(mode); }
        language-selected(mode) => { root.settings-language-selected(mode); }
        add-account => { root.welcome-add-account(); }
        finish => { root.welcome-finish(); }
    }
    AccountWizard { x: 0px; y: 0px; width: parent.width; height: parent.height; open: root.wizard-open; manual <=> root.wizard-manual; status: root.wizard-status; busy: root.wizard-busy; provider <=> root.wizard-provider;
        advanced <=> root.wizard-advanced; settings-ready: root.wizard-settings-ready; storage-error: root.wizard-storage-error;
        google-available: root.google-available; microsoft-available: root.microsoft-available; smtp-username <=> root.smtp-username;
        reconnecting: root.wizard-reconnect-id != "";
        email <=> root.email; imap-host <=> root.imap-host; imap-port <=> root.imap-port;
        smtp-host <=> root.smtp-host; smtp-port <=> root.smtp-port; username <=> root.username;
        password <=> root.password; starttls <=> root.starttls; smtp-starttls <=> root.smtp-starttls;
        provider-selected(p) => { root.wizard-provider-selected(p); }
        oauth-clicked(p) => { root.wizard-oauth-clicked(p); } add-generic => { root.wizard-add-generic(); } cancel => { root.wizard-cancel(); }
        discover => { root.wizard-discover(); } storage-choice(session) => { root.wizard-storage-choice(session); } app-password => { root.wizard-app-password(); }
        email-edited(value) => { root.wizard-email-edited(value); }
    }
    SettingsDialog { x: 0px; y: 0px; width: parent.width; height: parent.height; open: root.settings-open; accounts: root.settings-accounts; theme: root.settings-theme; language: root.settings-language;
        online-avatars: root.online-avatars; avatars-toggled(enabled) => { root.avatars-toggled(enabled); }
        theme-selected(m) => { root.settings-theme-selected(m); } language-selected(m) => { root.settings-language-selected(m); }
        account-remove(id) => { root.settings-account-remove(id); } add-account => { root.settings-open = false; root.wizard-open = true; }
        account-reconnect(id) => { root.settings-account-reconnect(id); }
        account-unlock(id) => { root.settings-account-unlock(id); }
        close => { root.settings-close(); }
    }
    OrganizationDialog { x: 0px; y: 0px; width: parent.width; height: parent.height;
        open: root.organization-open; managing <=> root.managing-labels; labels: root.labels;
        category-index <=> root.organization-category; effective-category: root.organization-effective;
        message-override: root.organization-message-override; sender-override: root.organization-sender-override;
        error: root.organization-error;
        category-saved(index, sender) => { root.category-saved(index, sender); }
        label-assigned(id, assigned) => { root.label-assigned(id, assigned); }
        label-saved(id, name, color) => { root.label-saved(id, name, color); }
        label-deleted(id) => { root.label-deleted(id); }
        close => { root.organization-close(); }
    }
    AttachmentPreview { x: 0px; y: 0px; width: parent.width; height: parent.height;
        open: root.preview-open; title: root.preview-title; kind: root.preview-kind;
        text: root.preview-text; image: root.preview-image;
        save-clicked => { root.save-open = true; }
        close => { root.preview-open = false; }
    }
    SaveDialog { x: 0px; y: 0px; width: parent.width; height: parent.height;
        open: root.save-open; filename: root.save-filename; path <=> root.save-path;
        confirmed => { root.attachment-save(root.save-path); root.save-open = false; }
        close => { root.save-open = false; }
    }
    DraftsDialog { x: 0px; y: 0px; width: parent.width; height: parent.height;
        open: root.drafts-open || root.templates-open || root.sends-open;
        kind: root.sends-open ? "sends" : root.templates-open ? "templates" : "drafts";
        drafts: root.drafts; templates: root.templates; sends: root.sends;
        row-clicked(id) => { if root.templates-open { root.template-row-clicked(id); } else if !root.sends-open { root.draft-row-clicked(id); } }
        row-delete(id) => { if root.sends-open { root.send-row-delete(id); } else if root.templates-open { root.template-row-delete(id); } else { root.draft-row-delete(id); } }
        close => { root.drafts-dialog-close(); }
    }
    // Right-click menu for a message in the list. Rust resolves the target in
    // the store and sets the menu state before showing the popup.
    message-menu := PopupWindow {
        x: root.menu-x; y: root.menu-y;
        width: 252px;
        // 9 menu items × 32px + 2 separator rows × 7px + vertical padding 12px
        // + spacing between the 11 rows 10 × 2px = 334px.
        height: 334px;
        Rectangle {
            background: Theme.bg;
            border-radius: 10px;
            border-width: 1px; border-color: Theme.border;
            drop-shadow-blur: 16px; drop-shadow-color: #00000030; drop-shadow-offset-y: 3px;
            VerticalLayout {
                padding: 6px; spacing: 2px;
                ContextMenuItem {
                    visible: root.menu-batch;
                    text: @tr("Mark read"); icon: @image-url("icons/mail.svg");
                    activated => { root.batch-action("read"); message-menu.close(); }
                }
                ContextMenuItem {
                    visible: root.menu-batch;
                    text: @tr("Star"); icon: @image-url("icons/star.svg");
                    activated => { root.batch-action("star"); message-menu.close(); }
                }
                ContextMenuItem {
                    visible: root.menu-batch;
                    text: @tr("Move to..."); icon: @image-url("icons/folder.svg");
                    activated => { message-menu.close(); move-menu.show(); }
                }
                ContextMenuItem {
                    visible: root.menu-batch;
                    text: @tr("Delete"); icon: @image-url("icons/trash.svg"); danger: true;
                    activated => { root.batch-action("delete"); message-menu.close(); }
                }
                ContextMenuItem {
                    visible: !root.menu-batch;
                    text: @tr("Open"); icon: @image-url("icons/eye.svg");
                    activated => { root.message-selected(root.menu-message); root.detail-open = true; message-menu.close(); }
                }
                ContextMenuItem {
                    visible: !root.menu-batch;
                    text: @tr("Reply"); icon: @image-url("icons/back.svg");
                    activated => { root.message-action(root.menu-message, "reply"); message-menu.close(); }
                }
                ContextMenuItem {
                    visible: !root.menu-batch;
                    text: @tr("Reply to all"); icon: @image-url("icons/person.svg");
                    activated => { root.message-action(root.menu-message, "reply-all"); message-menu.close(); }
                }
                ContextMenuItem {
                    visible: !root.menu-batch;
                    text: @tr("Forward"); icon: @image-url("icons/forward.svg");
                    activated => { root.message-action(root.menu-message, "forward"); message-menu.close(); }
                }
                Rectangle { visible: !root.menu-batch; height: 7px; Rectangle { y: 3px; width: parent.width; height: 1px; background: Theme.border; } }
                ContextMenuItem {
                    visible: !root.menu-batch;
                    text: root.menu-msg-unread ? @tr("Mark as read") : @tr("Mark as unread"); icon: @image-url("icons/mail.svg");
                    activated => { root.message-action(root.menu-message, "read"); message-menu.close(); }
                }
                ContextMenuItem {
                    visible: !root.menu-batch;
                    text: root.menu-msg-starred ? @tr("Unstar") : @tr("Star"); icon: @image-url("icons/star.svg");
                    activated => { root.message-action(root.menu-message, "star"); message-menu.close(); }
                }
                Rectangle { visible: !root.menu-batch; height: 7px; Rectangle { y: 3px; width: parent.width; height: 1px; background: Theme.border; } }
                ContextMenuItem {
                    visible: !root.menu-batch;
                    text: @tr("Move to..."); icon: @image-url("icons/folder.svg");
                    activated => { message-menu.close(); move-menu.show(); }
                }
                ContextMenuItem {
                    visible: !root.menu-batch;
                    text: @tr("Snooze"); icon: @image-url("icons/clock.svg");
                    activated => { root.message-action(root.menu-message, "snooze"); message-menu.close(); }
                }
                ContextMenuItem {
                    visible: !root.menu-batch;
                    text: root.menu-msg-permanent ? @tr("Delete permanently") : @tr("Delete"); icon: @image-url("icons/trash.svg"); danger: true;
                    activated => { root.message-action(root.menu-message, "delete"); message-menu.close(); }
                }
                ContextMenuItem {
                    visible: root.menu-batch;
                    text: @tr("Delete"); icon: @image-url("icons/trash.svg"); danger: true;
                    activated => { root.batch-action("delete"); message-menu.close(); }
                }
            }
        }
    }
    // In-place replacement of the message menu: the folder list to move the
    // message's account folders into (message's own folder excluded; filled
    // by Rust when the context menu is opened).
    move-menu := PopupWindow {
        x: root.menu-x; y: root.menu-y;
        width: 252px;
        height: 292px;
        Rectangle {
            background: Theme.bg;
            border-radius: 10px;
            border-width: 1px; border-color: Theme.border;
            drop-shadow-blur: 16px; drop-shadow-color: #00000030; drop-shadow-offset-y: 3px;
            VerticalLayout {
                padding: 6px; spacing: 2px;
                Text {
                    height: 24px;
                    text: @tr("Move to...");
                    color: Theme.text-secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Rectangle { height: 1px; background: Theme.border; }
                ListView {
                    height: 252px;
                    for folder in root.move-folders : ContextMenuItem {
                        text: folder.name;
                        icon: folder.kind == "trash" ? @image-url("icons/trash.svg") : folder.kind == "inbox" ? @image-url("icons/inbox.svg") : folder.kind == "sent" ? @image-url("icons/send.svg") : folder.kind == "draft" ? @image-url("icons/file.svg") : @image-url("icons/folder.svg");
                        activated => { move-menu.close(); root.move-selected(folder.id); }
                    }
                }
                if root.move-folders.length == 0 : Text {
                    height: 24px;
                    text: @tr("No other folder");
                    color: Theme.text-secondary;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }
    folder-menu := PopupWindow {
        x: root.menu-x; y: root.menu-y;
        width: 236px; height: root.menu-folder-kind == "trash" || root.menu-folder-kind == "junk" ? 174px : 142px;
        Rectangle {
            background: Theme.bg; border-radius: 10px; border-width: 1px; border-color: Theme.border;
            drop-shadow-blur: 16px; drop-shadow-color: #00000030; drop-shadow-offset-y: 3px;
            VerticalLayout { padding: 6px; spacing: 2px;
                ContextMenuItem { text: @tr("Mark all as read"); icon: @image-url("icons/mail.svg"); activated => { folder-menu.close(); root.folder-action(root.menu-folder, "read", ""); } }
                if root.menu-folder-kind == "trash" || root.menu-folder-kind == "junk": ContextMenuItem {
                    text: @tr("Empty folder"); icon: @image-url("icons/trash.svg"); danger: true;
                    activated => { folder-menu.close(); root.folder-action(root.menu-folder, "empty", ""); }
                }
                Rectangle { height: 1px; background: Theme.border; }
                ContextMenuItem { text: @tr("New folder"); icon: @image-url("icons/plus.svg"); activated => { folder-menu.close(); root.folder-dialog-mode = "create"; root.folder-dialog-name = ""; } }
                ContextMenuItem { visible: !root.menu-folder-inbox; text: @tr("Rename"); icon: @image-url("icons/folder.svg"); activated => { folder-menu.close(); root.folder-dialog-mode = "rename"; root.folder-dialog-name = root.menu-folder-name; } }
                ContextMenuItem { visible: !root.menu-folder-inbox; text: @tr("Delete folder"); icon: @image-url("icons/trash.svg"); danger: true; activated => { folder-menu.close(); root.folder-dialog-mode = "delete"; } }
            }
        }
    }
    if root.folder-dialog-mode != "" : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height; background: #00000066;
        TouchArea { clicked => { root.folder-dialog-mode = ""; } }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 420px; height: root.folder-dialog-mode == "delete" ? 140px : 176px;
            background: Theme.bg; border-radius: 12px; border-width: 1px; border-color: Theme.border;
            VerticalLayout { padding: 16px; spacing: 12px;
                Text { text: root.folder-dialog-mode == "create" ? @tr("New folder") : root.folder-dialog-mode == "rename" ? @tr("Rename folder") : @tr("Delete folder?"); color: Theme.text; font-size: 15px; font-weight: 600; }
                if root.folder-dialog-mode == "delete" : Text { text: @tr("This folder and its messages will be deleted."); color: Theme.text-secondary; font-size: 13px; }
                if root.folder-dialog-mode != "delete" : LineEdit { text <=> root.folder-dialog-name; placeholder-text: @tr("Folder name"); }
                HorizontalLayout { alignment: end; spacing: 8px;
                    ActionButton { framed: true; text: @tr("Cancel"); clicked => { root.folder-dialog-mode = ""; } }
                    ActionButton { primary: true; text: root.folder-dialog-mode == "delete" ? @tr("Delete") : @tr("Save"); clicked => {
                        if root.folder-dialog-mode == "delete" { root.folder-action(root.menu-folder, "delete", ""); }
                        else if root.folder-dialog-name != "" { root.folder-action(root.menu-folder, root.folder-dialog-mode, root.folder-dialog-name); }
                        root.folder-dialog-mode = "";
                    } }
                }
            }
            TouchArea { }
        }
    }
    }
}
