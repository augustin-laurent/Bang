import { Theme } from "theme.slint";

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> modal: false;
    private property <bool> can-activate: self.enabled && (!Theme.blocked || self.modal);
    in property <bool> framed: false;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> compact: false;
    callback clicked;
    out property <bool> button-hovered: touch.has-hover;
    out property <bool> button-pressed: touch.pressed;
    callback focus-button();
    focus-button => { focus.focus(); }
    min-width: compact ? 32px : 96px;
    max-width: compact ? 36px : 300px;
    horizontal-stretch: compact ? 0 : 1;
    min-height: 32px; max-height: 32px; preferred-height: 32px;
    border-radius: 9px;
    background: primary ? Theme.selection : active || touch.has-hover ? Theme.hover : framed ? Theme.bg : transparent;
    // Hover and active states transition instead of snapping.
    animate background { duration: Theme.motion ? Theme.dur-fast : 0ms; }
    border-width: focus.has-focus ? 2px : framed ? 1px : 0px;
    border-color: focus.has-focus ? Theme.accent : root.active ? Theme.control-border : Theme.border;
    opacity: can-activate ? 1 : 0.5;
    accessible-enabled: can-activate;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if root.can-activate { root.clicked(); } }
    forward-focus: focus;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 6px; alignment: center;
        if root.icon != @image-url(""): Rectangle {
            width: 18px;
            Image { source: root.icon; width: 18px; height: 18px; y: (parent.height - self.height) / 2; colorize: root.primary ? white : Theme.text; }
        }
        if !root.compact: Text { text: root.text; color: root.primary ? white : Theme.text; font-size: 13px; vertical-alignment: center; }
    }
    focus := FocusScope {
        enabled: root.can-activate;
        key-pressed(e) => {
            if root.can-activate && (e.text == " " || e.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.can-activate; clicked => { focus.focus(); root.clicked(); } }
    // Tooltips use an input-transparent overlay above sibling panes and lists.
    if root.compact && root.can-activate: Tooltip {
        Rectangle {
            width: max(96px, label.preferred-width + 16px); height: 28px;
            background: Theme.text; border-radius: 6px;
            label := Text { text: root.text; color: Theme.bg; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

// Explicit theme colours keep form text and focus rings readable on both themes.
export component Field inherits VerticalLayout {
    callback edited(string);
    in property <string> label;
    in property <string> placeholder;
    in property <bool> secret: false;
    private property <bool> revealed: false;
    changed text => { if self.text == "" { self.revealed = false; } }
    in property <bool> enabled: true;
    in-out property <string> text;
    spacing: 6px;
    Text { text: root.label; color: Theme.text; font-size: 13px; font-weight: 500; }
    Rectangle {
        min-width: 60px; min-height: 40px; max-height: 40px;
        background: Theme.field-bg; border-radius: 6px;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.accent : Theme.control-border;
        opacity: root.enabled ? 1 : 0.6;
        forward-focus: input;
        if root.text == "": Text { x: 12px; width: parent.width - 24px; height: parent.height;
            text: root.placeholder; color: Theme.text-secondary; font-size: 13px; vertical-alignment: center; overflow: elide;
        }
        input := TextInput {
            edited => { root.edited(self.text); }
            x: 12px; width: parent.width - (root.secret ? 52px : 24px); height: parent.height;
            text <=> root.text; color: Theme.text; font-size: 13px; single-line: true;
            read-only: !root.enabled; input-type: root.secret && !root.revealed ? InputType.password : InputType.text;
            selection-background-color: Theme.selection; selection-foreground-color: Theme.selected-text;
            vertical-alignment: center; accessible-label: root.label;
        }
        if root.secret: ActionButton { x: parent.width - 38px; y: 4px; width: 32px; height: 32px; modal: true; compact: true;
            enabled: root.enabled; text: root.revealed ? @tr("Hide password") : @tr("Show password");
            icon: @image-url("icons/eye.svg"); active: root.revealed;
            clicked => { root.revealed = !root.revealed; }
        }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: @tr("Search");
    callback edited(string);
    public function focus-input() { input.focus(); }
    preferred-height: 32px; min-height: 32px; max-height: 32px;
    border-radius: 12px; background: Theme.bg;
    border-width: 1px; border-color: input.has-focus ? Theme.accent : Theme.border;
    forward-focus: input;
    Image { x: 10px; y: 8px; width: 16px; height: 16px; source: @image-url("icons/search.svg"); colorize: Theme.text-secondary; }
    if root.text == "": Text { x: 34px; width: parent.width - 44px; text: root.placeholder; color: Theme.text-secondary; font-size: 13px; vertical-alignment: center; }
    input := TextInput { x: 34px; width: parent.width - 44px; height: parent.height;
        text <=> root.text; color: Theme.text; font-size: 13px;
        single-line: true; read-only: Theme.blocked; input-type: search; vertical-alignment: center;
        selection-background-color: Theme.selection; selection-foreground-color: white;
        accessible-label: root.placeholder;
        edited => { root.edited(self.text); }
    }
}

// A visible unchecked outline is essential on the light surface.
export component CheckControl inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled();
    min-height: 32px; max-height: 32px;
    accessible-role: checkbox; accessible-label: root.text; accessible-checked: root.checked;
    accessible-action-default => { root.checked = !root.checked; root.toggled(); }
    forward-focus: focus;
    HorizontalLayout { spacing: 10px;
        Rectangle { width: 20px;
            Rectangle { y: (parent.height - self.height) / 2; width: 20px; height: 20px; border-radius: 4px;
                background: root.checked ? Theme.selection : Theme.field-bg;
                border-width: focus.has-focus ? 2px : 1px; border-color: focus.has-focus ? Theme.accent : root.checked ? Theme.selection : Theme.control-border;
                if root.checked: Image { x: 2px; y: 2px; width: 16px; height: 16px; source: @image-url("icons/check.svg"); colorize: Theme.selected-text; }
            }
        }
        Text { text: root.text; color: Theme.text; font-size: 13px; vertical-alignment: center; }
    }
    focus := FocusScope { key-pressed(e) => { if e.text == " " { root.checked = !root.checked; root.toggled(); return accept; } return reject; } }
    TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.checked = !root.checked; root.toggled(); } }
}
