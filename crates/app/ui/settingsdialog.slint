import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ActionButton, CheckControl } from "controls.slint";
import { AccountRow } from "models.slint";
// Each miniature has its own palette; the selected label always uses the live theme.
export component ThemeOption inherits Rectangle {
    in property <string> name; in property <string> mode; in property <bool> selected;
    callback chosen();
    in property <bool> compact: false;
    height: compact ? 88px : 104px; border-radius: 8px;
    border-width: root.selected || focus.has-focus ? 2px : 1px;
    border-color: root.selected || focus.has-focus ? Theme.accent : Theme.control-border;
    background: touch.has-hover ? Theme.hover : Theme.bg;
    accessible-role: button; accessible-label: root.name;
    accessible-action-default => { root.chosen(); }
    forward-focus: focus;
    Rectangle { x: 10px; y: 10px; width: parent.width - 20px; height: parent.height - 52px;
        clip: true; border-radius: 4px; background: root.mode == "dark" ? #242426 : #eceef1;
        Rectangle { x: 0px; width: parent.width * 0.27; height: parent.height; background: root.mode == "dark" ? #353538 : #d9dde3; }
        Rectangle { x: parent.width * 0.3; y: 6px; width: parent.width * 0.28; height: 40px; background: root.mode == "dark" ? #1c1c1e : #ffffff;
            Rectangle { x: 3px; y: 5px; width: parent.width - 6px; height: 8px; border-radius: 2px; background: root.selected ? Theme.selection : root.mode == "dark" ? #66666b : #b9bec7; }
            Rectangle { x: 3px; y: 19px; width: parent.width - 6px; height: 3px; background: root.mode == "dark" ? #66666b : #d9dde3; }
        }
        Rectangle { x: parent.width * 0.62; y: 6px; width: parent.width * 0.34; height: 40px; background: root.mode == "dark" || root.mode == "system" ? #1c1c1e : #ffffff;
            Rectangle { x: 6px; y: 8px; width: parent.width - 12px; height: 3px; background: root.mode == "light" ? #b9bec7 : #929298; }
            Rectangle { x: 6px; y: 16px; width: parent.width - 12px; height: 3px; background: root.mode == "light" ? #d9dde3 : #66666b; }
        }
    }
    Text { y: parent.height - 34px; height: 26px; text: root.name; color: Theme.text; font-size: 13px; font-weight: root.selected ? 600 : 400; horizontal-alignment: center; vertical-alignment: center; }
    focus := FocusScope { key-pressed(e) => { if e.text == " " || e.text == "\n" { root.chosen(); return accept; } return reject; } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.chosen(); } }
}

export component SettingsDialog inherits Rectangle {
    in property <bool> open; in property <[AccountRow]> accounts;
    in property <bool> online-avatars: true; callback avatars-toggled(bool);
    in property <string> theme; in property <string> language;
    private property <string> remove-id; private property <string> remove-email;
    callback theme-selected(string); callback language-selected(string);
    callback account-remove(string); callback add-account; callback close;
    callback account-reconnect(string);
    callback account-unlock(string);
    // Cards ease in from slightly below instead of popping in.
    private property <float> entrance: 1;
    changed open => {
        if self.open && Theme.motion { self.entrance = 0; entrance-timer.running = true; }
        if !self.open { self.remove-id = ""; }
    }
    entrance-timer := Timer { interval: 1ms; running: false; triggered => { self.running = false; root.entrance = 1; } }
    animate entrance { duration: Theme.motion ? Theme.dur-med : 0ms; easing: ease-out; }
    visible: open; background: #00000066; TouchArea { }
    Rectangle {
        width: min(600px, parent.width - 40px); height: min(720px, parent.height - 32px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + 10px * (1.0 - root.entrance);
        opacity: root.entrance;
        border-radius: 16px; background: Theme.bg;
        VerticalLayout { padding: 24px; spacing: 20px;
            Text { text: @tr("Settings"); color: Theme.text; font-size: 20px; font-weight: 600; }
            ScrollView { content-width: self.visible-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                VerticalLayout { spacing: 20px; padding: 4px; alignment: start;
                    Text { text: @tr("Appearance"); color: Theme.text; font-size: 14px; font-weight: 600; }
                    HorizontalLayout { spacing: 12px;
                        ThemeOption { name: @tr("System"); mode: "system"; selected: root.theme == "system"; chosen => { root.theme-selected("system"); } }
                        ThemeOption { name: @tr("Light"); mode: "light"; selected: root.theme == "light"; chosen => { root.theme-selected("light"); } }
                        ThemeOption { name: @tr("Dark"); mode: "dark"; selected: root.theme == "dark"; chosen => { root.theme-selected("dark"); } }
                    }
                    CheckControl { text: @tr("Online avatars"); checked: root.online-avatars; toggled => { root.avatars-toggled(self.checked); } }
                    Text { text: @tr("Language"); color: Theme.text; font-size: 14px; font-weight: 600; }
                    HorizontalLayout { spacing: 8px;
                        ActionButton { modal: true; text: @tr("System"); active: root.language == "system"; framed: true; clicked => { root.language-selected("system"); } }
                        ActionButton { modal: true; text: "Français"; active: root.language == "fr"; framed: true; clicked => { root.language-selected("fr"); } }
                        ActionButton { modal: true; text: "English"; active: root.language == "en"; framed: true; clicked => { root.language-selected("en"); } }
                    }
                    Text { text: @tr("Accounts"); color: Theme.text; font-size: 14px; font-weight: 600; }
                    if root.accounts.length == 0: Text { text: @tr("No accounts"); color: Theme.text-secondary; font-size: 13px; }
                    for acc in root.accounts: HorizontalLayout { height: 48px; spacing: 12px;
                        Rectangle { width: 24px; Image { y: (parent.height - self.height) / 2; width: 24px; height: 24px; image-fit: contain; source: acc.provider == "google" ? @image-url("icons/google.svg") : acc.provider == "microsoft" ? @image-url("icons/microsoft.svg") : acc.provider == "icloud" ? @image-url("icons/icloud.svg") : @image-url("icons/mail.svg"); colorize: acc.provider == "" ? Theme.text-secondary : transparent; } }
                        Text { text: acc.email; color: Theme.text; font-size: 13px; overflow: elide; vertical-alignment: center; }
                        if acc.reconnect: ActionButton { modal: true; text: @tr("Reconnect"); clicked => { root.account-reconnect(acc.id); } }
                        if acc.storage-locked: ActionButton { modal: true; text: @tr("Unlock"); clicked => { root.account-unlock(acc.id); } }
                        ActionButton { modal: true; text: @tr("Remove"); enabled: !acc.removing; icon: @image-url("icons/trash.svg"); clicked => { root.remove-id = acc.id; root.remove-email = acc.email; } }
                    }
                    ActionButton { modal: true; text: @tr("Add account"); framed: true; icon: @image-url("icons/plus.svg"); clicked => { root.add-account(); } }
                }
            }
            ActionButton { modal: true; text: @tr("Close"); clicked => { root.close(); } }
        }
    }
    if root.remove-id != "": remove-dim := Rectangle {
        background: #00000066; TouchArea { }
        // Overlay block is recreated on open, so entrance animates naturally.
        private property <float> appear: 1;
        init => { if Theme.motion { self.appear = 0; remove-appear-timer.running = true; } }
        remove-appear-timer := Timer { interval: 1ms; running: false; triggered => { self.running = false; remove-dim.appear = 1; } }
        animate appear { duration: Theme.motion ? Theme.dur-med : 0ms; easing: ease-out; }
        opacity: self.appear;
        Rectangle { width: min(400px, parent.width - 32px); height: 210px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + 10px * (1.0 - remove-dim.appear);
            background: Theme.bg; border-radius: 16px;
            VerticalLayout { padding: 24px; spacing: 16px;
                Text { text: @tr("Remove this account?"); color: Theme.text; font-size: 16px; font-weight: 600; }
                Text { text: root.remove-email + "\n" + @tr("Its cached messages will be removed from this device."); wrap: word-wrap; color: Theme.text-secondary; font-size: 13px; }
                HorizontalLayout { spacing: 8px;
                    ActionButton { modal: true; text: @tr("Cancel"); clicked => { root.remove-id = ""; } }
                    ActionButton { modal: true; text: @tr("Remove"); clicked => { root.account-remove(root.remove-id); root.remove-id = ""; } }
                }
            }
        }
    }
}
