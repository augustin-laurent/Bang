import { Theme } from "theme.slint";
import { ActionButton } from "controls.slint";
import { CheckBox, LineEdit, ScrollView } from "std-widgets.slint";
import { LabelRow } from "models.slint";

// Category and scope choices are segmented pills and label colours are
// dots, matching the chips the labels render as elsewhere in the UI.
component Pill inherits ActionButton {
    in property <bool> selected: false;
    min-width: 0px; max-width: 1000px;
    horizontal-stretch: 1;
    active: self.selected;
}

component ColorDot inherits Rectangle {
    in property <color> tint;
    in property <bool> current;
    in property <string> name;
    callback chosen();
    width: 32px;
    height: 32px;
    border-radius: self.width / 2;
    border-width: self.current ? 2px : 0px;
    border-color: Theme.text;
    accessible-role: button;
    accessible-label: self.name;
    Rectangle {
        x: 4px; y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: self.width / 2;
        background: root.tint;
    }
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" { root.chosen(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.chosen(); } }
}

export component OrganizationDialog inherits Rectangle {
    in property <bool> open;
    in-out property <bool> managing: false;
    in property <[LabelRow]> labels;
    in-out property <int> category-index: 0;
    in property <string> effective-category;
    in property <bool> message-override;
    in property <bool> sender-override;
    in property <string> error;
    private property <int> scope-index: 0;
    private property <int> edit-id: -1;
    private property <string> edit-name;
    private property <int> edit-color: 0;
    callback category-saved(int, bool);
    callback label-assigned(int, bool);
    callback label-saved(int, string, string);
    callback label-deleted(int);
    callback close;
    changed open => { if self.open { self.scope-index = 0; self.edit-id = -1; self.edit-name = ""; self.edit-color = 0; } }
    visible: root.open; background: #00000066; TouchArea { }
    // Hexes mirror organization.rs COLORS; the index maps through it in Rust.
    Rectangle {
        width: min(520px, parent.width - 40px); height: min(620px, parent.height - 32px);
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        background: Theme.bg; border-radius: Theme.radius-md;
        VerticalLayout { padding: 24px; spacing: 14px;
            Text { text: root.managing ? @tr("Manage labels") : @tr("Classify message"); color: Theme.text; font-size: 20px; font-weight: 600; }
            if !root.managing: VerticalLayout { spacing: 10px;
                Text { text: @tr("Category") + ": " + root.effective-category; color: Theme.text-secondary; font-size: 12px; }
                HorizontalLayout { spacing: 8px;
                    Pill { selected: root.category-index == 0; text: @tr("Automatic"); clicked => { root.category-index = 0; } }
                    Pill { selected: root.category-index == 1; text: @tr("Primary"); clicked => { root.category-index = 1; } }
                    Rectangle { width: 1px; }
                }
                HorizontalLayout { spacing: 8px;
                    Pill { selected: root.category-index == 2; text: @tr("Transactions"); clicked => { root.category-index = 2; } }
                    Pill { selected: root.category-index == 3; text: @tr("Updates"); clicked => { root.category-index = 3; } }
                    Pill { selected: root.category-index == 4; text: @tr("Promotions"); clicked => { root.category-index = 4; } }
                }
                HorizontalLayout { spacing: 8px;
                    Pill { selected: root.scope-index == 0; text: @tr("This message"); clicked => { root.scope-index = 0; } }
                    Pill { selected: root.scope-index == 1; text: @tr("All messages from this sender"); clicked => { root.scope-index = 1; } }
                }
                if root.message-override || root.sender-override: Text { text: root.message-override ? @tr("This message has its own category correction.") : @tr("A sender rule applies to this message."); color: Theme.text-secondary; font-size: 11px; wrap: word-wrap; }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { modal: true; primary: true; text: @tr("Apply category"); clicked => { root.category-saved(root.category-index, root.scope-index == 1); } }
                }
            }
            HorizontalLayout {
                Text { text: @tr("Labels"); color: Theme.text; font-weight: 600; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                if !root.managing: ActionButton { modal: true; framed: true; text: @tr("Manage labels"); clicked => { root.managing = true; } }
            }
            ScrollView { min-height: 60px; vertical-stretch: 1; content-width: self.visible-width; horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                VerticalLayout { width: parent.width; height: self.preferred-height; spacing: 4px;
                    if root.labels.length == 0: Text { text: @tr("No labels yet"); color: Theme.text-secondary; font-size: 13px; }
                    for label in root.labels: Rectangle {
                        height: 34px; border-radius: 8px;
                        background: row-area.has-hover ? Theme.hover : transparent;
                        row-area := TouchArea { }
                        HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px;
                            Rectangle { width: 10px; Rectangle { width: 10px; height: 10px; y: (parent.height - self.height) / 2; border-radius: 5px; background: label.tint; } }
                            if !root.managing: CheckBox { text: label.name; checked: label.assigned; toggled => { root.label-assigned(label.id, self.checked); } }
                            if root.managing: Text { text: label.name; color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            if root.managing: ActionButton { modal: true; compact: true; text: @tr("Edit label"); icon: @image-url("icons/compose.svg"); clicked => { root.edit-id = label.id; root.edit-name = label.name; root.edit-color = label.color-index; } }
                            if root.managing: ActionButton { modal: true; compact: true; text: @tr("Delete label"); icon: @image-url("icons/trash.svg"); clicked => { root.label-deleted(label.id); } }
                        }
                    }
                }
            }
            if root.managing: VerticalLayout { spacing: 10px;
                Text { text: root.edit-id < 0 ? @tr("New label") : @tr("Edit label"); color: Theme.text; font-size: 13px; font-weight: 600; }
                LineEdit { accessible-label: @tr("Label name"); placeholder-text: @tr("Label name"); text <=> root.edit-name; }
                HorizontalLayout { spacing: 8px;
                    ColorDot { tint: #3977b8; current: root.edit-color == 0; name: @tr("Blue"); chosen => { root.edit-color = 0; } }
                    ColorDot { tint: #30845b; current: root.edit-color == 1; name: @tr("Green"); chosen => { root.edit-color = 1; } }
                    ColorDot { tint: #b96c17; current: root.edit-color == 2; name: @tr("Orange"); chosen => { root.edit-color = 2; } }
                    ColorDot { tint: #ba4655; current: root.edit-color == 3; name: @tr("Red"); chosen => { root.edit-color = 3; } }
                    ColorDot { tint: #8555a6; current: root.edit-color == 4; name: @tr("Purple"); chosen => { root.edit-color = 4; } }
                    ColorDot { tint: #6b7280; current: root.edit-color == 5; name: @tr("Gray"); chosen => { root.edit-color = 5; } }
                }
                HorizontalLayout { spacing: 8px;
                    ActionButton { modal: true; framed: true; enabled: root.edit-name != ""; text: @tr("Save label"); clicked => { root.label-saved(root.edit-id, root.edit-name, root.edit-color == 1 ? "#30845b" : root.edit-color == 2 ? "#b96c17" : root.edit-color == 3 ? "#ba4655" : root.edit-color == 4 ? "#8555a6" : root.edit-color == 5 ? "#6b7280" : "#3977b8"); } }
                    ActionButton { modal: true; framed: true; text: @tr("New label"); clicked => { root.edit-id = -1; root.edit-name = ""; root.edit-color = 0; } }
                }
            }
            if root.error != "": Text { text: root.error; color: Theme.danger; wrap: word-wrap; font-size: 12px; }
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                ActionButton { modal: true; framed: true; text: @tr("Close"); clicked => { root.close(); } }
            }
        }
    }
}
