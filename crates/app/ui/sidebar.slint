import { Button, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FolderRow } from "models.slint";

// Left sidebar: account status and folder list.
export component Sidebar inherits Rectangle {
    background: Theme.sidebar-bg;

    in property <[FolderRow]> folders;
    in property <int> selected-folder: -1;
    in property <string> account-status: "";

    callback add-account;
    callback folder-clicked(id: int);

    VerticalLayout {
        padding: Theme.space-sm;
        spacing: Theme.space-xs;
        alignment: start;

        Text {
            text: "Bang";
            color: Theme.accent;
            font-size: Theme.font-size-xxl;
            font-weight: Theme.font-weight-bold;
        }

        Text {
            visible: root.account-status != "";
            text: root.account-status;
            color: Theme.text-secondary;
            font-size: Theme.font-size-xs;
        }

        ListView {
            for folder in root.folders: Rectangle {
                height: 28px;
                border-radius: Theme.radius-sm;
                background: folder.id == root.selected-folder ? Theme.hover : transparent;

                TouchArea {
                    clicked => {
                        root.folder-clicked(folder.id);
                    }
                }

                Text {
                    text: folder.name;
                    x: Theme.space-sm;
                    y: 7px;
                    color: Theme.text;
                    font-size: Theme.font-size-md;
                }

                if folder.unread > 0: Text {
                    text: folder.unread;
                    x: 180px;
                    y: 7px;
                    color: Theme.accent;
                    font-size: Theme.font-size-sm;
                }
            }
        }

        Button {
            text: "+ Add account";
            clicked => {
                root.add-account();
            }
        }
    }
}
