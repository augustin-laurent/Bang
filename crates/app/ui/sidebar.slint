import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FolderRow } from "models.slint";

// Left sidebar: account status and folder list.
export component Sidebar inherits Rectangle {
    background: Theme.sidebar-bg;

    in property <[FolderRow]> folders;
    in property <int> selected-folder: -1;
    in property <string> account-status: "";

    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        alignment: start;

        Text {
            text: "Bang";
            color: Theme.accent;
            font-size: 18px;
            font-weight: 700;
        }

        Text {
            visible: root.account-status != "";
            text: root.account-status;
            color: Theme.text-secondary;
            font-size: 11px;
        }

        ListView {
            for folder in root.folders: Rectangle {
                height: 28px;
                border-radius: 6px;
                background: folder.id == root.selected-folder ? Theme.hover : transparent;

                Text {
                    text: folder.name;
                    x: 8px;
                    y: 7px;
                    color: Theme.text;
                    font-size: 13px;
                }

                if folder.unread > 0: Text {
                    text: folder.unread;
                    x: 180px;
                    y: 7px;
                    color: Theme.accent;
                    font-size: 12px;
                }
            }
        }
    }
}
