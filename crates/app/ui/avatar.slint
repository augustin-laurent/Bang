import { Theme } from "theme.slint";
// Photos are validated, resized and circularly masked before entering Slint.
export component SenderAvatar inherits Rectangle {
    in property <image> photo;
    in property <bool> has-photo: false;
    in property <string> initials;
    in property <color> tint: #527aa3;
    clip: true;
    border-radius: self.width / 2;
    background: !root.has-photo ? root.tint : transparent;
    // Cover keeps squares square: sources are pre-cropped, but contain
    // would letterbox non-square fallbacks.
    if root.has-photo: Image {
        x: 0px; y: 0px; width: root.width; height: root.height;
        source: root.photo; image-fit: cover;
    }
    if !root.has-photo: Text {
        text: root.initials; color: white; font-size: parent.width * 0.34; font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center;
    }
}
