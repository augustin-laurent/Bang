import { Theme } from "theme.slint";

// Right pane: message reading area.
export component ReadingPane inherits Rectangle {
    background: Theme.reading-bg;

    in property <string> sender: "";
    in property <string> subject: "";
    in property <string> date: "";
    in property <string> body: "";

    if root.subject == "": Text {
        text: "Select a message to read it";
        x: Theme.space-lg;
        y: Theme.space-lg;
        color: Theme.text-secondary;
        font-size: Theme.font-size-md;
    }

    VerticalLayout {
        padding: Theme.space-lg;
        spacing: Theme.space-sm;

        Text {
            text: root.subject;
            color: Theme.text;
            font-size: Theme.font-size-xl;
            font-weight: Theme.font-weight-semibold;
            wrap: word-wrap;
        }

        Text {
            text: root.sender + " — " + root.date;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        Text {
            text: root.body;
            color: Theme.text;
            font-size: Theme.font-size-lg;
            wrap: word-wrap;
        }
    }
}
