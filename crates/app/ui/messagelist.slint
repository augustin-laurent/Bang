import { ListView } from "std-widgets.slint";
import { SenderAvatar } from "avatar.slint";
import { Theme } from "theme.slint";
import { MessageRow } from "models.slint";
export component MessageList inherits Rectangle {
    background: Theme.bg;
    in property <[MessageRow]> messages;
    in property <int> selected-message: -1;
    private property <length> swipe-threshold: 60px;
    private property <length> row-height: 90px;
    public function reset-scroll() { list.content-y = 0px; }
    public function reveal-row(index: int) {
        if index < 0 || index >= root.messages.length { return; }
        let top = index * root.row-height;
        let bottom = top + root.row-height;
        if top < -list.content-y { list.content-y = -top; }
        else if bottom > -list.content-y + list.visible-height {
            // Slint rounds distant seeks to rows; round toward visibility.
            list.content-y = -ceil((bottom - list.visible-height) / root.row-height) * root.row-height;
        }
        list.content-y = clamp(list.content-y, -ceil(max(0px, list.content-height - list.visible-height) / root.row-height) * root.row-height, 0px);
    }
    callback message-clicked(int, bool, bool, int);
    callback message-action(int, string);
    // Right click: local store id plus the cursor position in window
    // coordinates (for placing the popup menu).
    callback message-context(int, length, length);
    list := ListView {
        // GTK may deliver events before the first size allocation. Preserve
        // the ScrollView minimum so its inset viewport never becomes negative.
        height: max(50px, root.height);
        content-width: self.visible-width;
        // ListView must own content-height to skip rows on distant seeks.
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        for msg[index] in root.messages: Rectangle {
            height: root.row-height;
            background: Theme.bg;
            Rectangle {
                x: 6px; y: 3px; width: parent.width - 12px; height: 84px;
                border-radius: 6px;
                background: msg.id == root.selected-message ? Theme.selection : msg.is-selected ? Theme.selection : area.has-hover ? Theme.toolbar-bg : transparent;
                Rectangle { visible: msg.unread && !area.has-hover && !msg.is-selected; x: 7px; y: 15px; width: 7px; height: 7px; border-radius: 4px; background: msg.id == root.selected-message ? white : Theme.accent; }
                Rectangle {
                    visible: area.has-hover || msg.is-selected;
                    x: 4px; y: 11px; width: 18px; height: 18px; border-radius: 4px;
                    border-width: msg.is-selected ? 0px : 1px;
                    border-color: msg.id == root.selected-message ? white : Theme.text-secondary;
                    background: msg.is-selected ? Theme.selection : transparent;
                    if msg.is-selected: Image { source: @image-url("icons/check.svg"); x: 3px; y: 3px; width: 12px; height: 12px; colorize: white; }
                }
                SenderAvatar { x: 20px; y: 10px; width: 32px; height: 32px; photo: msg.avatar; has-photo: msg.has-avatar; initials: msg.initials; tint: msg.avatar-tint; }
                Text { x: 62px; y: 9px; width: parent.width - 136px; text: msg.sender; font-size: 13px; font-weight: 600; color: msg.id == root.selected-message ? white : Theme.text; overflow: elide; }
                Text { x: parent.width - 72px; y: 10px; width: 62px; text: msg.date; font-size: 11px; horizontal-alignment: right; color: msg.id == root.selected-message ? white : Theme.text-secondary; overflow: elide; }
                Text { x: 62px; y: 29px; width: parent.width - 76px; text: msg.subject; font-size: 12px; color: msg.id == root.selected-message ? white : Theme.text; overflow: elide; }
                Text { x: 62px; y: 47px; width: parent.width - 80px; height: 34px; text: msg.preview; max-lines: 2; wrap: word-wrap; font-size: 12px; color: msg.id == root.selected-message ? white : Theme.text-secondary; }
                Image { visible: msg.has-attachments; x: parent.width - 22px; y: 50px; width: 12px; height: 12px; source: @image-url("icons/clip.svg"); colorize: msg.id == root.selected-message ? white : Theme.text-secondary; }
                area := TouchArea {
                    enabled: !Theme.blocked;
                    // Swipe right stars, left deletes; a short press selects.
                    clicked => {
                        let dx = self.mouse-x - self.pressed-x;
                        if dx > root.swipe-threshold { root.message-action(msg.id, "star"); }
                        else if dx < -root.swipe-threshold { root.message-action(msg.id, "delete"); }
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                            root.message-clicked(msg.id, event.modifiers.control, event.modifiers.shift, index);
                        }
                        if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                            root.message-context(msg.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
                accessible-role: button; accessible-enabled: !Theme.blocked; accessible-label: msg.sender + ", " + msg.subject;
                accessible-action-default => { if !Theme.blocked { root.message-clicked(msg.id, false, false, index); } }
            }
            Rectangle { x: 68px; y: parent.height - 1px; width: parent.width - 80px; height: 1px; background: Theme.border; }
        }
    }
}
