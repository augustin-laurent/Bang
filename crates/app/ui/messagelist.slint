import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { MessageRow } from "models.slint";

// Center pane: message list.
export component MessageList inherits Rectangle {
    background: Theme.bg;

    in property <[MessageRow]> messages;
    in property <int> selected-message: -1;

    callback message-clicked(id: int);

    if root.messages.length == 0: Text {
        text: "No messages";
        x: Theme.space-lg;
        y: Theme.space-lg;
        color: Theme.text-secondary;
        font-size: Theme.font-size-md;
    }

    ListView {
        for msg in root.messages: Rectangle {
            height: 56px;
            background: msg.id == root.selected-message ? Theme.hover : transparent;

            TouchArea {
                clicked => {
                    root.message-clicked(msg.id);
                }
            }

            Text {
                text: msg.sender;
                x: Theme.space-md;
                y: Theme.space-sm;
                width: parent.width - 120px;
                color: msg.unread ? Theme.text : Theme.text-secondary;
                font-size: Theme.font-size-md;
                font-weight: msg.unread ? Theme.font-weight-semibold : Theme.font-weight-regular;
                overflow: elide;
            }

            Text {
                text: msg.date;
                x: parent.width - 90px;
                y: Theme.space-sm;
                width: 78px;
                color: Theme.text-secondary;
                font-size: Theme.font-size-xs;
                overflow: elide;
            }

            Text {
                text: msg.subject;
                x: Theme.space-md;
                y: 28px;
                width: parent.width - 120px;
                color: Theme.text;
                font-size: Theme.font-size-md;
                overflow: elide;
            }

            Text {
                text: msg.preview;
                x: Theme.space-md;
                y: 42px;
                width: parent.width - 120px;
                color: Theme.text-secondary;
                font-size: Theme.font-size-xs;
                overflow: elide;
            }
        }
    }
}
