import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { MessageRow } from "models.slint";
export component MessageList inherits Rectangle {
    background: Theme.bg;
    in property <[MessageRow]> messages;
    in property <int> selected-message: -1;
    callback message-clicked(int);
    callback message-action(int, string);
    list := ListView {
        for msg in root.messages: Rectangle {
            height: 90px;
            background: Theme.bg;
            Rectangle {
                x: 6px; y: 3px; width: parent.width - 12px; height: 84px;
                border-radius: 6px;
                background: msg.id == root.selected-message ? Theme.selection : area.has-hover ? Theme.toolbar-bg : transparent;
                Rectangle { visible: msg.unread; x: 7px; y: 15px; width: 7px; height: 7px; border-radius: 4px; background: msg.id == root.selected-message ? white : Theme.accent; }
                Text { x: 22px; y: 9px; width: parent.width - 96px; text: msg.sender; font-size: 13px; font-weight: 600; color: msg.id == root.selected-message ? white : Theme.text; overflow: elide; }
                Text { x: parent.width - 72px; y: 10px; width: 62px; text: msg.date; font-size: 11px; horizontal-alignment: right; color: msg.id == root.selected-message ? white : Theme.text-secondary; overflow: elide; }
                Text { x: 22px; y: 29px; width: parent.width - 36px; text: msg.subject; font-size: 12px; color: msg.id == root.selected-message ? white : Theme.text; overflow: elide; }
                Text { x: 22px; y: 47px; width: parent.width - 40px; height: 34px; text: msg.preview; max-lines: 2; wrap: word-wrap; font-size: 12px; color: msg.id == root.selected-message ? white : Theme.text-secondary; }
                Image { visible: msg.has-attachments; x: parent.width - 22px; y: 50px; width: 12px; height: 12px; source: @image-url("icons/clip.svg"); colorize: msg.id == root.selected-message ? white : Theme.text-secondary; }
                area := TouchArea { enabled: !Theme.blocked; clicked => { root.message-clicked(msg.id); } }
                accessible-role: button; accessible-enabled: !Theme.blocked; accessible-label: msg.sender + ", " + msg.subject;
                accessible-action-default => { if !Theme.blocked { root.message-clicked(msg.id); } }
            }
            Rectangle { x: 26px; y: parent.height - 1px; width: parent.width - 38px; height: 1px; background: Theme.border; }
        }
    }
}
