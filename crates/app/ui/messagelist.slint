import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { MessageRow } from "models.slint";

// Center pane: message list.
export component MessageList inherits Rectangle {
    background: Theme.bg;

    in property <[MessageRow]> messages;
    in property <int> selected-message: -1;

    callback message-clicked(id: int);
    callback message-action(id: int, action: string);

    if root.messages.length == 0: Text {
        text: "No messages";
        x: Theme.space-lg;
        y: Theme.space-lg;
        color: Theme.text-secondary;
        font-size: Theme.font-size-md;
    }

    ListView {
        for msg in root.messages: Rectangle {
            height: 56px;
            background: msg.id == root.selected-message ? Theme.hover : transparent;

            TouchArea {
                clicked => {
                    root.message-clicked(msg.id);
                }
            }

            // Unread indicator.
            Rectangle {
                visible: msg.unread;
                x: 6px;
                y: 14px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent;
            }

            Text {
                text: msg.sender;
                x: 20px;
                y: Theme.space-sm;
                width: parent.width - 108px;
                color: msg.unread ? Theme.text : Theme.text-secondary;
                font-size: Theme.font-size-md;
                font-weight: msg.unread ? Theme.font-weight-semibold : Theme.font-weight-regular;
                overflow: elide;
            }

            Text {
                text: msg.date;
                x: parent.width - 96px;
                y: Theme.space-sm;
                width: 72px;
                color: Theme.text-secondary;
                font-size: Theme.font-size-xs;
                overflow: elide;
            }

            Text {
                text: msg.subject;
                x: 20px;
                y: 28px;
                width: parent.width - 108px;
                color: Theme.text;
                font-size: Theme.font-size-md;
                overflow: elide;
            }

            Text {
                text: msg.preview;
                x: 20px;
                y: 42px;
                width: parent.width - 108px;
                color: Theme.text-secondary;
                font-size: Theme.font-size-xs;
                overflow: elide;
            }

            // Row actions: star, mark read/unread, delete.
            Rectangle {
                x: parent.width - 78px;
                y: 28px;
                width: 24px;
                height: 24px;
                TouchArea {
                    clicked => {
                        root.message-action(msg.id, "star");
                    }
                }
                Text {
                    text: msg.starred ? "★" : "☆";
                    width: 24px;
                    height: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: msg.starred ? Theme.accent : Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                }
            }

            Rectangle {
                x: parent.width - 50px;
                y: 28px;
                width: 24px;
                height: 24px;
                TouchArea {
                    clicked => {
                        root.message-action(msg.id, "read");
                    }
                }
                Text {
                    text: msg.unread ? "●" : "○";
                    width: 24px;
                    height: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: msg.unread ? Theme.accent : Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                }
            }

            Rectangle {
                x: parent.width - 22px;
                y: 28px;
                width: 24px;
                height: 24px;
                TouchArea {
                    clicked => {
                        root.message-action(msg.id, "delete");
                    }
                }
                Text {
                    text: "✕";
                    width: 24px;
                    height: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                }
            }
        }
    }
}
