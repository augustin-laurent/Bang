import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ActionButton } from "controls.slint";

/// Ask for a destination path before saving an attachment.
export component SaveDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> filename;
    in-out property <string> path;
    callback confirmed();
    callback close();
    visible: root.open;
    background: #00000066;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: min(560px, parent.width - 80px);
        background: Theme.bg; border-radius: 12px;
        VerticalLayout { padding: 16px; spacing: 12px;
            Text { text: @tr("Save as…"); font-size: 14px; font-weight: 600; color: Theme.text; }
            Text { text: root.filename; font-size: 12px; color: Theme.text-secondary; overflow: elide; }
            LineEdit { text <=> root.path; placeholder-text: @tr("Destination path"); min-height: 36px; }
            HorizontalLayout { alignment: end; spacing: 8px;
                ActionButton { framed: true; text: @tr("Cancel"); clicked => { root.close(); } }
                ActionButton { primary: true; text: @tr("Save"); clicked => { root.confirmed(); } }
            }
        }
        // Swallow clicks so the backdrop's close-on-click does not fire.
        TouchArea { }
    }
}
