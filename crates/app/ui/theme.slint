import { Palette } from "std-widgets.slint";
// Shared opaque Mail-inspired surfaces. All sizes are logical pixels.
export global Theme {
    in property <bool> dark: false;
    in property <bool> blocked: false;
    // Animations honour reduced-motion by using 0ms durations everywhere.
    in property <bool> motion: true;
    changed dark => { self.sync-palette(); }
    callback sync-palette();
    sync-palette => { Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light; }
    // Canvas sits behind the floating panel islands; surfaces sit on it.
    out property <color> canvas: dark ? #161618 : #eff1f3;
    out property <color> bg: dark ? #1c1c1e : #ffffff;
    out property <color> sidebar-bg: dark ? #242426 : #f5f6f7;
    out property <color> reading-bg: bg;
    out property <color> toolbar-bg: dark ? #242426 : #fafafb;
    out property <color> text: dark ? #f4f4f6 : #202124;
    out property <color> text-secondary: dark ? #b4b4bc : #626267;
    out property <color> accent: dark ? #4094ff : #0864d6;
    out property <color> selection: dark ? #075bca : #0864d6;
    out property <color> hover: dark ? #343438 : #e8e9ec;
    out property <color> border: dark ? #38383b : #e5e6e9;
    out property <color> field-bg: dark ? #29292c : #ffffff;
    out property <color> selected-text: #ffffff;
    out property <color> control-border: dark ? #66666b : #a6a7ae;
    out property <color> danger: dark ? #ff8a91 : #bd2635;
    out property <length> font-size-xs: 11px;
    out property <length> font-size-sm: 12px;
    out property <length> font-size-md: 13px;
    out property <length> font-size-lg: 14px;
    out property <length> font-size-xl: 16px;
    out property <length> font-size-xxl: 20px;
    out property <int> font-weight-regular: 400;
    out property <int> font-weight-medium: 500;
    out property <int> font-weight-semibold: 600;
    out property <int> font-weight-bold: 700;
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 16px;
    // One scrim everywhere; low-effort entrance animation durations.
    out property <color> scrim: #00000066;
    out property <duration> dur-fast: 120ms;
    out property <duration> dur-med: 180ms;
}
